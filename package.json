{
  "name": "grafana-labs-grafana-3-d-scatter-panel",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "e2e": "yarn cypress install && yarn grafana-e2e run",
    "e2e:update": "yarn cypress install && yarn grafana-e2e run --update-screenshots",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn lint --fix",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\""
  },
  "author": "Team 3D Panels",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.20.12",
    "@grafana/e2e": "9.2.5",
    "@grafana/e2e-selectors": "9.2.5",
    "@grafana/eslint-config": "5.1.0",
    "@grafana/tsconfig": "1.2.0-rc1",
    "@swc/core": "1.3.32",
    "@swc/helpers": "0.4.14",
    "@swc/jest": "0.2.24",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "12.1.5",
    "@types/glob": "8.0.1",
    "@types/jest": "29.4.0",
    "@types/lodash": "4.14.191",
    "@types/node": "18.11.18",
    "@typescript-eslint/eslint-plugin": "5.50.0",
    "@typescript-eslint/parser": "5.50.0",
    "copy-webpack-plugin": "11.0.0",
    "cspell": "6.13.3",
    "css-loader": "6.7.3",
    "eslint": "8.26.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-jsdoc": "39.7.5",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-webpack-plugin": "3.2.0",
    "fork-ts-checker-webpack-plugin": "7.3.0",
    "glob": "8.1.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.4.1",
    "jest-environment-jsdom": "29.4.1",
    "prettier": "2.8.3",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.56.1",
    "sass-loader": "13.2.0",
    "style-loader": "3.3.1",
    "swc-loader": "0.2.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.1.2",
    "typescript": "4.9.5",
    "webpack": "5.75.0",
    "webpack-cli": "4.10.0",
    "webpack-livereload-plugin": "3.0.2"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@grafana/data": "latest",
    "@grafana/runtime": "^8.4.3",
    "@grafana/ui": "^8.4.3",
    "@react-three/drei": "^8.16.0",
    "@react-three/fiber": "^7.0.26",
    "@react-three/postprocessing": "^2.1.6",
    "@types/three": "^0.138.0",
    "emotion": "^11.0.0",
